# =============================================================================
# secrets.toml.example
# -----------------------------------------------------------------------------
# Streamlit은 API 키 같은 민감한 정보를 ".streamlit/secrets.toml" 파일에 담아
# 관리하는 것을 공식적으로 지원합니다.
#
# 사용 방법:
#   1) 이 파일을 복사해서 같은 폴더(.streamlit/)에 "secrets.toml" 이라는
#      이름으로 저장합니다.
#        cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   2) 아래 값들 중 사용할 항목을 실제 발급받은 키로 바꿉니다.
#
# ⚠️ "secrets.toml" 파일은 .gitignore에 등록되어 있어서 GitHub에 올라가지
#    않습니다. Streamlit Community Cloud에 배포할 때는 앱 설정(App settings)의
#    "Secrets" 메뉴에 이 파일과 동일한 내용을 붙여넣어 주세요.
# =============================================================================

# --- 기본값: OpenAI API 사용 시 ---
OPENAI_API_KEY = "your-openai-api-key-here"

# --- 선택: Gemini API를 사용하고 싶다면 아래 두 줄의 주석을 해제하세요 ---
# AI_PROVIDER = "gemini"
# GEMINI_API_KEY = "your-gemini-api-key-here"
