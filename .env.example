# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# 이 파일은 "예시" 파일입니다. 실제로 사용하려면 아래 두 단계를 따라주세요.
#
#   1) 이 파일을 복사해서 이름을 ".env" 로 바꿉니다. (같은 폴더에 위치)
#        cp .env.example .env
#   2) 아래 값들 중 사용할 항목의 "your-...-here" 부분을 실제 발급받은 키로 바꿉니다.
#
# ⚠️ ".env" 파일은 절대 GitHub 등 외부에 공유하면 안 됩니다.
#    (이미 .gitignore에 등록되어 있어서 실수로 커밋되지 않습니다.)
# =============================================================================

# --- 기본값: OpenAI API 사용 시 ---
# OpenAI 홈페이지(https://platform.openai.com/api-keys)에서 발급받은 키를 입력하세요.
OPENAI_API_KEY=your-openai-api-key-here

# --- 선택: Gemini API를 사용하고 싶다면 아래 두 줄의 주석을 해제하세요 ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
